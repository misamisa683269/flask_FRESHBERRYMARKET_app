# コピーして .env にリネームし、値を書き換えてください
SECRET_KEY=change-me-to-a-long-random-string

# 注文確認メール（開発中は true のまま。ターミナルに内容を表示し、実送信しない）
MAIL_SUPPRESS_SEND=true

# 将来の実送信用（今は未使用でOK）
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=noreply@example.com

# Stripe テストキー（Dashboard のサンドボックス API キーを貼る）
# 本番キー（sk_live_ / pk_live_）は使わないでください
STRIPE_SECRET_KEY=sk_test_ここにシークレットキーを貼る
STRIPE_PUBLISHABLE_KEY=pk_test_ここに公開可能キーを貼る
