[Unit]
Description=FRESHBERRYMARKET Flask (gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/freshberrymarket
EnvironmentFile=/var/www/freshberrymarket/.env
ExecStart=/var/www/freshberrymarket/.venv/bin/gunicorn \
    --bind 127.0.0.1:8000 \
    --workers 2 \
    --threads 4 \
    --timeout 120 \
    app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
